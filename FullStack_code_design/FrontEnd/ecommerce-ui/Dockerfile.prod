# ╔══════════════════════════════════════════════════════════════╗
# ║   Angular Production Dockerfile — Multi-Stage Build          ║
# ╚══════════════════════════════════════════════════════════════╝
#
# SYSTEM DESIGN: Multi-stage builds
#   Stage 1 (builder): Node image — installs deps, runs ng build
#   Stage 2 (runtime): Nginx image — only the dist/ output, no Node
#   Result: final image is ~25MB instead of ~500MB
#
# SYSTEM DESIGN: Nginx as reverse proxy
#   /api/*   → proxied to Spring Boot (upstream service)
#   /*       → serves Angular index.html (SPA routing)

# ── Stage 1: Build ───────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --silent
COPY . .
RUN npx ng build --configuration production

# ── Stage 2: Serve ───────────────────────────────────────────────
FROM nginx:alpine AS runtime
# Copy compiled Angular app into Nginx's web root
COPY --from=builder /app/dist/ecommerce-ui/browser /usr/share/nginx/html
# Custom Nginx config: SPA routing + /api proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
